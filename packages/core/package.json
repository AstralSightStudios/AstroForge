{
  "name": "@astralsight/astroforge-core",
  "version": "0.0.10",
  "description": "AstroForge Core: JSX runtime、Components、hooks。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstralSightStudios/AstroForge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AstralSightStudios/AstroForge#readme",
  "bugs": {
    "url": "https://github.com/AstralSightStudios/AstroForge/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components.d.mts",
      "import": "./dist/components.mjs"
    },
    "./apis": {
      "types": "./dist/apis.d.mts",
      "import": "./dist/apis.mjs"
    },
    "./platform": {
      "types": "./dist/platform.d.mts",
      "import": "./dist/platform.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.mts",
      "import": "./dist/hooks.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  }
}

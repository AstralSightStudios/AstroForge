{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeModule",
  "description": "设备运行时装载的最小单元：应用入口、页面入口或自定义组件入口。\n\n序列化策略与 [`OptValue`] 一致，使用 adjacent tagging 以保持跨 IR 枚举 形态对称。",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "app"
          ]
        },
        "value": {
          "$ref": "#/definitions/AppHandler"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "page"
          ]
        },
        "value": {
          "$ref": "#/definitions/PageHandler"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "component"
          ]
        },
        "value": {
          "$ref": "#/definitions/ComponentHandler"
        }
      }
    }
  ],
  "definitions": {
    "AppHandler": {
      "description": "应用入口模块（`app.js`）的运行时形态。",
      "type": "object",
      "required": [
        "create_handler",
        "install_translate_style",
        "manifest_json",
        "script_body",
        "style_table"
      ],
      "properties": {
        "create_handler": {
          "description": "包装函数名。当前固定为 `\"createAppHandler\"`，以字段形式存储以便后续 适配其它运行时变体。",
          "type": "string"
        },
        "script_body": {
          "description": "用户 `app.ux` 中 `export default { ... }` 对象的源码片段，整段写入 `exports.default = ...` 赋值位置。本层不解析内部结构，仅保证语法位置 正确。",
          "type": "string"
        },
        "style_table": {
          "description": "应用模块按惯例无样式，但保留字段以维持模块结构同构。序列化结果为 `$app_style$ = []`。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StyleEntry"
          }
        },
        "manifest_json": {
          "description": "内联 `manifest.json` 文本。后端注册为 `./src/manifest.json` 这个 webpack 模块，模块体为 `module.exports = JSON.parse(...)`。",
          "type": "string"
        },
        "install_translate_style": {
          "description": "是否在 `__webpack_require__.g` 上注入 `$translateStyle$`。仅 app 模块 安装一次，全局共享。",
          "type": "boolean"
        }
      }
    },
    "StyleEntry": {
      "description": "样式表中的一行。\n\n序列化目标形态为嵌套数组： `[ [[selectorKind, name], ...], { camelCaseProp: \"value\" } ]` 本结构保持字段命名，打印阶段压缩为位置敏感数组。",
      "type": "object",
      "required": [
        "declarations",
        "selectors"
      ],
      "properties": {
        "selectors": {
          "description": "单个样式项的选择器描述。\n\n外层 [`Vec`] 为兼容早期 IR 保留；Vela 打印阶段会将其中的 simple selector 链压平为官方 `selectorArr`。逗号分隔的多个 selector 应在 下沉阶段拆成多个 [`StyleEntry`]，不能在单项中多包一层数组。",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": [
                {
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                {
                  "type": "string"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          }
        },
        "declarations": {
          "description": "camelCase 属性名 → 带单位字符串值。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "PageHandler": {
      "description": "页面入口模块（`pages/<name>/<name>.js`）的运行时形态。",
      "type": "object",
      "required": [
        "create_handler",
        "script_body",
        "style_table",
        "template_root"
      ],
      "properties": {
        "create_handler": {
          "description": "当前固定为 `\"createPageHandler\"`。",
          "type": "string"
        },
        "script_body": {
          "type": "string"
        },
        "template_root": {
          "$ref": "#/definitions/RuntimeNode"
        },
        "style_table": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StyleEntry"
          }
        },
        "component_imports": {
          "description": "页面引用的自定义组件清单，将在页面 entry 之前注册到 `$app_exports$`。 键为模板中使用的 kebab-case 标签名，值为 webpack moduleId（沿用厂商 形式 `\"./src/components/<name>.ux\"` 以利对照 diff）。",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "RuntimeNode": {
      "description": "一次运行时元素创建调用。\n\n子节点采用同型结构递归。运行时层不存在 React 中的组件边界——每个节点都 是一次直接调用。",
      "type": "object",
      "required": [
        "children",
        "creator",
        "opts",
        "tag"
      ],
      "properties": {
        "creator": {
          "$ref": "#/definitions/Creator"
        },
        "tag": {
          "type": "string"
        },
        "opts": {
          "description": "`__opts__` 对象内容。使用 [`IndexMap`] 以保留属性顺序——厂商产物的 属性顺序稳定，对照测试需按位对齐，HashMap 不可用。",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/OptValue"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuntimeNode"
          }
        }
      }
    },
    "Creator": {
      "description": "节点创建器类型。",
      "oneOf": [
        {
          "description": "内置元素，下沉为 `aiot.__ce__`。",
          "type": "string",
          "enum": [
            "builtin"
          ]
        },
        {
          "description": "自定义组件，下沉为 `aiot.__cc__`。",
          "type": "string",
          "enum": [
            "component"
          ]
        }
      ]
    },
    "OptValue": {
      "description": "`__opts__` 中各槽位的值。各变体形状参见 `docs/vela-runtime-abi.md` §7。\n\n下沉阶段的主要职责即将 Component IR 中的属性归类至本枚举的合适变体。\n\n序列化采用 adjacent tagging（`{ \"kind\": ..., \"value\": ... }`），保持与 Component IR 中 [`crate::component::Node`] 等枚举一致的形态。",
      "oneOf": [
        {
          "description": "静态 class 列表，形如 `classList: [\"title\", \"active\"]`。 动态 class 应使用 [`OptValue::Dynamic`]。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "class_list"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "description": "任意 JSON 可序列化字面量：字符串、数字、布尔。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "static"
              ]
            },
            "value": true
          }
        },
        {
          "description": "动态求值表达式。`expr` 为返回值表达式的 JS 源码片段，例如 `\"_vm_.message\"`。打印阶段套用 `function() { return <expr>; }`。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "dynamic"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "expr"
              ],
              "properties": {
                "expr": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "description": "内联 style 的动态表达式。`expr` 一般形如 `__webpack_require__.g.$translateStyle$(\"background-color: \" + _vm_.color)`。\n\n单独成变体的原因：内联 style 必须经 `$translateStyle$` 中转为属性对 象，此过程涉及运行时行为而非单纯求值，与 [`OptValue::Dynamic`] 的处 理路径不同。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "dynamic_style"
              ]
            },
            "value": {
              "type": "object",
              "required": [
                "expr"
              ],
              "properties": {
                "expr": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "description": "事件回调表，形如 `events: { click: function(evt) { return _vm_.onTap(evt) } }`。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "events"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/EventHandler"
              }
            }
          }
        },
        {
          "description": "属性装饰器，对应 UX 模板中 `attr.modifier` 语法。",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "modifiers"
              ]
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    "EventHandler": {
      "description": "事件回调描述。",
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "description": "视图模型上的方法名，例如 `\"onCardTap\"`。打印阶段拼接为 `function(evt) { return _vm_.<method>(evt); }`。",
          "type": "string"
        }
      }
    },
    "ComponentHandler": {
      "description": "自定义组件模块的运行时形态。",
      "type": "object",
      "required": [
        "name",
        "script_body",
        "style_table",
        "template_root"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "script_body": {
          "type": "string"
        },
        "template_root": {
          "$ref": "#/definitions/RuntimeNode"
        },
        "style_table": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StyleEntry"
          }
        }
      }
    }
  }
}
